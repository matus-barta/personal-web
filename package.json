{
	"name": "personal-web",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "node scripts/with-browsers.ts vitest",
		"test": "pnpm test:e2e",
		"test:e2e": "node scripts/with-browsers.ts playwright test",
		"test:browsers:stop": "docker rm --force personal-web-playwright"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.60.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^5.0.0",
		"bits-ui": "^2.19.5",
		"cn": "^0.5.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"github-slugger": "^2.0.0",
		"globals": "^17.4.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"reading-time": "1.5.0",
		"satori": "^0.63.2",
		"shadcn-svelte": "^1.7.0",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"simple-icons": "^16.35.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.0",
		"vitest-browser-svelte": "^3.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#app.css": "./src/routes/layout.css"
	}
}
